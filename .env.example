# ─── OpenAI ───
OPENAI_API_KEY=
OPENAI_REQUEST_TIMEOUT_MS=120000
OPENAI_TEXT_TIMEOUT_MS=25000
IMAGE2_JOB_TIMEOUT_MS=180000
IMAGE2_CONCURRENCY=4
IMAGE2_QUALITY=auto

# ─── 生成链路模式 ───
# FAST_DIRECT_MODE=1（默认）：底图 + 本地设计矩阵(已审美优选权重) + Skill prompt 直接生图，
#   完全跳过 gpt-4o 的「分析底图」和「规划方案」两次文本调用——又快又稳，且不会被 gpt-4o 稀释 Skill。
# FAST_DIRECT_MODE=0：走 gpt-4o 编排（额外两次文本调用，更慢、更贵），仅在需要 AI 重写文案时使用。
FAST_DIRECT_MODE=1

# ─── SeeDance / 即梦 CLI (仅本地开发用，线上不需要) ───
SEEDANCE_CLI_PATH=
SEEDANCE_MODEL_VERSION=
SEEDANCE_RESOLUTION_TYPE=2k
SEEDANCE_POLL_SECONDS=75
SEEDANCE_JOB_TIMEOUT_MS=150000
SEEDANCE_CONCURRENCY=1

# Backward-compatible aliases
DREAMINA_CLI_PATH=
DREAMINA_MODEL_VERSION=
DREAMINA_RESOLUTION_TYPE=
DREAMINA_RATIO=
DREAMINA_POLL_SECONDS=

# ─── Database (MySQL) ───
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=kingofcover

# ─── Redis (验证码 + 并发锁) ───
REDIS_URL=redis://127.0.0.1:6379

# ─── JWT ───
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ─── 腾讯云 SMS (短信验证码) ───
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# ─── 微信支付 (Phase 2) ───
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_APP_ID=
WECHAT_PAY_NOTIFY_URL=

# ─── 腾讯云 COS (图片存储, Phase 3) ───
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-hongkong

# ─── Admin 手机号（逗号分隔，这些号码注册后自动设为 admin，不消耗积分） ───
ADMIN_PHONES=

# ─── Server ───
PORT=8787
NODE_ENV=development

# 本地 LIPA 使用模式：localhost/127.0.0.1 默认不登录、不扣积分、不加水印。
# 设为 0 可关闭本地免费模式。
LOCAL_FREE_MODE=1

# ─── Generation Speed / Stability ───
# 单张图片超时和全局并发兜底；具体引擎配置会优先于这里。
# 并发越高，多张图越快“啡啡啡”一起出（上限 8，受 OpenAI 账号速率限制影响）。
IMAGE_JOB_TIMEOUT_MS=180000
GENERATION_CONCURRENCY=4
IMAGE_FETCH_TIMEOUT_MS=45000

# ─── Proxy (可选) ───
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NODE_TLS_REJECT_UNAUTHORIZED=0
