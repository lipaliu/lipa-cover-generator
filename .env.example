OPENAI_API_KEY=

# Optional: SeeDance / 即梦 CLI adapter.
# Install: curl -s https://jimeng.jianying.com/cli | bash
# Then run: dreamina login
SEEDANCE_CLI_PATH=
SEEDANCE_MODEL_VERSION=
SEEDANCE_RESOLUTION_TYPE=2k
SEEDANCE_POLL_SECONDS=75

# Backward-compatible aliases. Existing local configs using DREAMINA_* still work.
DREAMINA_CLI_PATH=
DREAMINA_MODEL_VERSION=
DREAMINA_RESOLUTION_TYPE=
DREAMINA_RATIO=
DREAMINA_POLL_SECONDS=

# Optional: local proxy for OpenAI API access.
# Example for local proxy tools:
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NODE_TLS_REJECT_UNAUTHORIZED=0
