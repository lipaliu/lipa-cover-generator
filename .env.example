OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Optional: override the DashScope image model/size.
# Defaults: wan2.6-image, 960*1280
DASHSCOPE_IMAGE_MODEL=
DASHSCOPE_IMAGE_SIZE=

# Optional: Dreamina / 即梦 CLI adapter.
# Install: curl -s https://jimeng.jianying.com/cli | bash
# Then run: dreamina login
DREAMINA_CLI_PATH=
DREAMINA_MODEL_VERSION=
DREAMINA_RESOLUTION_TYPE=2k
DREAMINA_RATIO=3:4
DREAMINA_POLL_SECONDS=75

# Reserved credentials for future adapters:
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
ZHIPUAI_API_KEY=
QIANFAN_ACCESS_KEY=
QIANFAN_SECRET_KEY=
